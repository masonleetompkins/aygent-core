{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AYGENT",
  "version": "1.0.5",
  "identifier": "build.masonlee.aygent",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)/ui\" && npm run dev'",
    "beforeBuildCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)/ui\" && npm run build'"
  },
  "app": {
    "windows": [
      {
        "title": "AYGENT",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob:; frame-src blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../daemon/dist": "daemon/dist",
      "../daemon/node_modules": "daemon/node_modules",
      "../daemon/package.json": "daemon/package.json",
      "../seatbelt/folder-mode.sb": "seatbelt/folder-mode.sb"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "HardenedRuntime.plist"
    }
  }
}
