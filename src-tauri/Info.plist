<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mic button (UI task #7): macOS requires this string before it will show
       the microphone permission prompt to a bundled app. Tauri v2 merges this
       file into the generated Info.plist at build time. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>AYGENT uses the microphone to record voice notes that are transcribed into the chat.</string>
</dict>
</plist>
